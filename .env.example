# Public/site configuration
PORTFOLIO_SITE_URL=https://portfolio.postlyfi.in
CORS_ORIGIN=https://portfolio.postlyfi.in
GITHUB_USERNAME=vishwas0229
LEETCODE_USERNAME=vishwas0229

# Backend cache configuration
GITHUB_CACHE_TTL_SECONDS=300
LEETCODE_CACHE_TTL_SECONDS=300
API_CACHE_STALE_SECONDS=3600

# Public API rate limiting (best-effort per warm serverless instance)
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_MAX=60

# Optional build/runtime version shown by /api/health
APP_VERSION=

# Firebase project used by Firebase Admin SDK (server-side only)
GOOGLE_CLOUD_PROJECT=portfolio-562da
# On Netlify, store the complete service-account JSON as a private environment variable.
# Never put this value in frontend files or commit a real key.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Admin session signing secret (generate a random value with at least 32 characters)
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_SECONDS=1800
COOKIE_SECURE=true

