# Public/site configuration
PORTFOLIO_SITE_URL=https://portfolio.postlyfi.in
CORS_ORIGIN=https://portfolio.postlyfi.in
GITHUB_USERNAME=vishwas0229
LEETCODE_USERNAME=vishwas0229

# Backend cache configuration
GITHUB_CACHE_TTL_SECONDS=300
LEETCODE_CACHE_TTL_SECONDS=300
API_CACHE_STALE_SECONDS=3600

# Public API rate limiting (best-effort per warm serverless instance)
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_MAX=60

# Optional build/runtime version shown by /api/health
APP_VERSION=

# MySQL database (server-side only)
DATABASE_URL=mysql://portfolio:portfolio_dev@localhost:3306/portfolio
DB_POOL_MAX=10

# Admin authentication
# Account credentials are stored in the MySQL admins table.
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_SECONDS=1800
COOKIE_SECURE=true

