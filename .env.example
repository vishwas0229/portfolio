# Public/site configuration
PORTFOLIO_SITE_URL=https://portfolio.postlyfi.in
CORS_ORIGIN=https://portfolio.postlyfi.in
GITHUB_USERNAME=vishwas0229
LEETCODE_USERNAME=vishwas0229

# Backend cache configuration
GITHUB_CACHE_TTL_SECONDS=300
LEETCODE_CACHE_TTL_SECONDS=300
API_CACHE_STALE_SECONDS=3600

# Public API rate limiting (best-effort per warm serverless instance)
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_MAX=60

# Optional build/runtime version shown by /api/health
APP_VERSION=

# Supabase database (server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin authentication (server-side only)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
COOKIE_SECURE=true

# SMTP contact notifications (server-side only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_FROM=
CONTACT_NOTIFICATION_EMAIL=
