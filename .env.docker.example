# Copy this file to .env for local Docker development.
# Replace all example values before exposing the service outside localhost.
MYSQL_DATABASE=portfolio
MYSQL_USER=portfolio
MYSQL_PASSWORD=replace_with_a_long_random_database_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_long_random_root_password
ADMIN_SESSION_SECRET=replace_with_at_least_32_random_characters
ADMIN_SESSION_TTL_SECONDS=1800
PORTFOLIO_SITE_URL=http://localhost:8888
CORS_ORIGIN=http://localhost:8888
COOKIE_SECURE=false
