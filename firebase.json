{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "server/**",
      "netlify/**",
      "api/**",
      "docs/**",
      "tests/**",
      "Dockerfile",
      "docker-compose.yml",
      "package.json",
      "package-lock.json",
      "README.md",
      ".env*"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
